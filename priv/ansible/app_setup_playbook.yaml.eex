- hosts: group_<%= @app_name %>
  environment:
    AWS_USE_DUALSTACK_ENDPOINT: true
  vars:
    app_name: "<%= @app_name %>"
    <%= if @port do %>app_port: <%= @port %><% end %>
  roles:
    - beam_linux_tuning
    - log_cleanup
    - pip3
    <%= if @cloud_provider == :oci do %>- oci_cli
    <% else %>- awscli
    <% end %>- ipv6
    <%= unless @no_prometheus do %>- prometheus_exporter
    <% end %>
    <%= unless @no_logging do %>- grafana_alloy
    <% end %>
    <%= if @cloud_provider !== :oci do %>- save_ami<% end %>
