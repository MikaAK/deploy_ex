COMPOSE_PROJECT_NAME=sentry-self-hosted

# errors-only: error monitoring per the user's ask. Upstream's install.sh
# hard-exits below 2 vCPU / 7000MB for this profile; t3.large clears it.
# Upgrade to feature-complete: resize the sentry node's instance_type to
# >= 4 vCPU/14GB (e.g. t3.xlarge) in terraform.build.ex's
# terraform_sentry_variables/1, flip this line to
# COMPOSE_PROFILES=feature-complete, then `mix terraform.apply --target
# 'module.ec2_instance["sentry"]'` + re-run `mix ansible.setup --only sentry`.
COMPOSE_PROFILES=errors-only
SENTRY_EVENT_RETENTION_DAYS=90

# Private VPC only — reachability is enforced by the security group (same
# convention as the loki/prometheus nodes), not by binding to loopback.
# Operators reach the UI via an SSH tunnel to this address (DeployEx.SSH).
SENTRY_BIND={{ ansible_default_ipv4.address }}:{{ sentry_web_port }}

SENTRY_TASKWORKER_CONCURRENCY=4
SENTRY_IMAGE=ghcr.io/getsentry/sentry:{{ sentry_release_version }}
SNUBA_IMAGE=ghcr.io/getsentry/snuba:{{ sentry_release_version }}
RELAY_IMAGE=ghcr.io/getsentry/relay:{{ sentry_release_version }}
SYMBOLICATOR_IMAGE=ghcr.io/getsentry/symbolicator:{{ sentry_release_version }}
TASKBROKER_IMAGE=ghcr.io/getsentry/taskbroker:{{ sentry_release_version }}
VROOM_IMAGE=ghcr.io/getsentry/vroom:{{ sentry_release_version }}
UPTIME_CHECKER_IMAGE=ghcr.io/getsentry/uptime-checker:{{ sentry_release_version }}
LAUNCHPAD_IMAGE=ghcr.io/getsentry/launchpad:{{ sentry_release_version }}

HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=1m30s
HEALTHCHECK_RETRIES=10
HEALTHCHECK_START_PERIOD=10s
HEALTHCHECK_FILE_INTERVAL=60s
HEALTHCHECK_FILE_TIMEOUT=10s
HEALTHCHECK_FILE_RETRIES=3
HEALTHCHECK_FILE_START_PERIOD=600s
