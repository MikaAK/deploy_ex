multitenancy_enabled: false

target: all

server:
  http_listen_port: {{ mimir_http_port }}

api:
  prometheus_http_prefix: /prometheus

common:
  storage:
    backend: filesystem
    filesystem:
      dir: /data/mimir/common

blocks_storage:
  filesystem:
    dir: /data/mimir/blocks
  bucket_store:
    sync_dir: /data/mimir/tsdb-sync
  tsdb:
    dir: /data/mimir/tsdb

compactor:
  data_dir: /data/mimir/compactor

ruler:
  rule_path: /data/mimir/ruler
  enable_api: true

# backend "local" (not "filesystem") is required for the ruler to actually
# load rule groups from files on disk — "filesystem" is a blocks-storage-only
# backend name and the ruler silently serves zero rule groups against it.
# This makes Mimir's ruler config HTTP API (POST/PUT/DELETE rule groups)
# read-only; rules are managed exclusively via the file below, sourced from
# prometheus_db's shared alert-rules template.
ruler_storage:
  backend: local
  local:
    directory: /data/mimir/rules

alertmanager:
  data_dir: /data/mimir/alertmanager

alertmanager_storage:
  filesystem:
    dir: /data/mimir/alertmanager-config

ingester:
  ring:
    replication_factor: 1

store_gateway:
  sharding_ring:
    replication_factor: 1

limits:
  compactor_blocks_retention_period: 30d
